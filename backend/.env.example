# Copy to backend/.env and fill keys as needed.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRUST_ENV=true
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_MAX_CONCURRENCY=5
OPENAI_MAIN_MAX_CONCURRENCY=4
OPENAI_QA_MAX_CONCURRENCY=1
OPENAI_RETRY_MAX_CONCURRENCY=1

# Search. DuckDuckGo works without an API key; Tavily is used when configured.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
DUCKDUCKGO_MAX_RESULTS=6
SEARCH_BROWSER_DISABLE_PROXY=true

STORAGE_BACKEND=sqlite
SQLITE_PATH=data/app.db
JSON_STORAGE_DIR=data/json
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/competitor_agent

MAX_REVISION_LOOPS=2
